# npm enforces peer dependencies strictly; yarn does not. Without this,
# `npm install` fails with ERESOLVE because react-day-picker@8.10.1 wants
# date-fns v2/v3 while this project uses date-fns v4.
# Cloudflare Pages uses npm when no lockfile is committed, so this file is
# what lets the production build install at all.
# Proper fix later: move react-day-picker to v9, which supports date-fns v4.
legacy-peer-deps=true
